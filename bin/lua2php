#!/usr/bin/env php
<?php

declare(strict_types=1);

// bin/lua2php: transpile Lua 5.4 to PHP ahead of time.
//
//     bin/lua2php in.lua [-o out.php]   one file (default output: in.php)
//     bin/lua2php dir [-o outdir]        every *.lua under dir, each to the same
//                                        relative path with .php (default: next to it)
//
// Every generated file runs as a script: `php out.php args...` behaves like
// `lua5.4 in.lua args...`, where in.lua is the input path as given or, in
// directory mode, the path relative to dir (run a project from its root).
// The runtime also loads generated files for require, dofile and loadfile:
// the Lua file x.lua is found as x.php (other names get .php appended; see
// ChunkLoader::precompiledFileName), and no Lua file is compiled at run
// time. Only load() of a string or reader function compiles (and caches).
//
// Syntax errors: in single-file mode lua2php reports the error and writes
// nothing. In directory mode it reports each error on stderr, still writes
// every file (one that did not compile raises exactly Lua's load error when
// the program loads it), and exits with status 1. A file that cannot be
// read, transpiled or written is reported the same way, and the others are
// still transpiled.
//
// Memory: like bin/lua, lua2php raises PHP's memory_limit (to 4G, at most
// max_memory_limit): transpiling a big file takes more than PHP's default.

// The program is LuaPhp\Cli\Lua2PhpCommand.

require __DIR__ . '/../src/autoload.php';

exit(\LuaPhp\Cli\Lua2PhpCommand::main($argv));
