#!/usr/bin/env php
<?php

declare(strict_types=1);

// bin/lua2php: transpile a Lua 5.4 script to a PHP script.
//
//     bin/lua2php in.lua [-o out.php]      (default output: in.php)
//
// `php out.php args...` then behaves like `lua5.4 in.lua args...`. The
// output holds the emitted PHP functions, the script's Proto as a binary
// chunk (for debug information and long string constants) and a bootstrap
// that loads the LuaPhp runtime; its header says how the runtime is found.

require __DIR__ . '/../src/autoload.php';

use LuaPhp\Compiler\CompileError;
use LuaPhp\Compiler\Compiler;
use LuaPhp\Compiler\Dump;
use LuaPhp\Compiler\Undump;
use LuaPhp\Emitter\Emitter;
use LuaPhp\Emitter\PhpLiteral;

$programName = (isset($argv[0]) && $argv[0] !== '') ? $argv[0] : 'lua2php';

function fail(string $message): never
{
    global $programName;
    fwrite(STDERR, "$programName: $message\n");
    exit(1);
}

function usage(string $message): never
{
    global $programName;
    fwrite(STDERR, "$programName: $message\nusage: $programName input.lua [-o output.php]\n");
    exit(1);
}

$inputFile = null;
$outputFile = null;
for ($i = 1; $i < count($argv); $i++) {
    if ($argv[$i] === '-o') {
        $outputFile = $argv[++$i] ?? usage("'-o' needs argument");
    } elseif ($inputFile === null && $argv[$i] !== '') {
        $inputFile = $argv[$i];
    } else {
        usage("unexpected argument '{$argv[$i]}'");
    }
}
if ($inputFile === null) {
    usage('no input file given');
}
$outputFile ??= (str_ends_with($inputFile, '.lua') ? substr($inputFile, 0, -4) : $inputFile) . '.php';

// lauxlib.c: luaL_loadfilex (skip a UTF-8 BOM and a first line starting with '#')
$contents = @file_get_contents($inputFile);
if ($contents === false || is_dir($inputFile)) {
    fail("cannot open $inputFile");
}
$position = str_starts_with($contents, "\xEF\xBB\xBF") ? 3 : 0;
$prefix = '';
if (($contents[$position] ?? '') === '#') {
    $newlinePosition = strpos($contents, "\n", $position);
    $position = $newlinePosition === false ? strlen($contents) : $newlinePosition + 1;
    $prefix = "\n";  // keep line numbers
}
$chunk = substr($contents, $position);
$chunkname = '@' . $inputFile;
$isBinaryInput = ($chunk[0] ?? '') === Undump::LUA_SIGNATURE[0];
try {
    $proto = $isBinaryInput
        ? Undump::undump($chunk, $chunkname)
        : Compiler::compile($prefix . $chunk, $chunkname);
} catch (CompileError $error) {
    fail($error->getMessage());
}

$runtimeAutoload = realpath(__DIR__ . '/../src/autoload.php');
$scriptName = PhpLiteral::string($inputFile);
$binaryChunk = PhpLiteral::string(Dump::dump($proto, false));
// a chunk compiled from source has one string per contents (llex.c: luaX_newstring)
$shareEqualStrings = $isBinaryInput ? 'false' : 'true';
$factory = Emitter::emitChunk($proto);
$preamble = Emitter::PREAMBLE;
$runtimeLiteral = PhpLiteral::string($runtimeAutoload);
$commentSafeInput = PhpLiteral::commentText($inputFile, 200);
$commentSafeRuntime = PhpLiteral::commentText($runtimeAutoload, 300);

$php = <<<PHP
<?php

// Generated by bin/lua2php from $commentSafeInput. Do not edit.
//
// Run it like the Lua script:   php <this file> args...
// (behaves like 'lua5.4 $commentSafeInput args...'; in the 'arg' table,
// index 0 is the Lua script name and -1 is this PHP file).
//
// Finding the runtime: this file needs the LuaPhp runtime (the src/
// directory of the lua-to-php-transpiler). It loads, in this order:
//   1. the file named by the environment variable LUAPHP_AUTOLOAD, or
//      src/autoload.php inside the directory named by LUAPHP_HOME;
//   2. the runtime this file was generated with:
//      $commentSafeRuntime
// The runtime must be the same version that generated this file.

$preamble
(static function (): void {
    \$autoload = getenv('LUAPHP_AUTOLOAD');
    if (\$autoload === false && getenv('LUAPHP_HOME') !== false) {
        \$autoload = rtrim(getenv('LUAPHP_HOME'), '/') . '/src/autoload.php';
    }
    if (\$autoload === false) {
        \$autoload = $runtimeLiteral;
    }
    if (!is_file(\$autoload)) {
        fwrite(STDERR, "cannot find the LuaPhp runtime at \$autoload (set LUAPHP_AUTOLOAD or LUAPHP_HOME)\\n");
        exit(1);
    }
    require_once \$autoload;
})();

\LuaPhp\Runtime\Standalone::configurePhp();

// the script's main function and all nested functions
\$factory = $factory;

// the script's function prototypes (a Lua 5.4 binary chunk) for debug
// information and long string constants
\$binaryChunk = $binaryChunk;

exit(\LuaPhp\Runtime\Standalone::runCompiledScript(\$argv, $scriptName, static function (\LuaPhp\Runtime\Coroutine \$L) use (\$factory, \$binaryChunk): \LuaPhp\Runtime\LuaClosure {
    \$main = \LuaPhp\Runtime\ChunkLoader::instantiate(\LuaPhp\Compiler\Undump::undump(\$binaryChunk, '=?', $shareEqualStrings), \$factory);
    if (\$main->upvals !== []) {
        \$main->upvals[0]->v = \$L->globalState->globals;  // _ENV
    }
    return \$main;
}));

PHP;

if (@file_put_contents($outputFile, $php) === false) {
    fail("cannot write $outputFile");
}
exit(0);
