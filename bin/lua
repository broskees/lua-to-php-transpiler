#!/usr/bin/env php
<?php

declare(strict_types=1);

// Port of lua.c (Lua 5.4.9), the stand-alone interpreter: options -e, -l,
// -i, -v, -E, -W, --, -, script and its arguments, the 'arg' table, error
// messages with tracebacks on stderr and exit status 1 on errors. The
// program name in messages is argv[0], as in lua.c.

// The program is LuaPhp\Cli\LuaCommand.

require __DIR__ . '/../src/autoload.php';

exit(\LuaPhp\Cli\LuaCommand::main($argv));
